{
  "name": "@real-case/sigil",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Live, interactive chart widgets for Claude and other MCP Apps hosts. Sigils carry meaning compressed into a glyph — same idea, applied to data.",
  "homepage": "https://sigil.live",
  "type": "module",
  "bin": {
    "sigil": "./dist/server/stdio.js"
  },
  "main": "./dist/server/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "dev:preview": "WIDGET=palette-preview vite",
    "dev:sandbox": "WIDGET=sandbox vite",
    "dev:storybook": "storybook dev -p 6006",
    "build": "npm run build:widgets && npm run build:server",
    "build:widgets": "tsx scripts/build-widgets.ts",
    "build:server": "tsc -p tsconfig.server.json && chmod +x dist/server/stdio.js",
    "build:storybook": "storybook build",
    "start": "node dist/server/server.js",
    "start:stdio": "node dist/server/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "rm -rf dist && npm run build"
  },
  "keywords": [
    "sigil",
    "mcp",
    "model-context-protocol",
    "mcp-apps",
    "claude",
    "charts",
    "visualization",
    "interactive",
    "dashboard"
  ],
  "license": "MIT",
  "author": "Yurii Anichkin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/real-case/sigil.git"
  },
  "bugs": {
    "url": "https://github.com/real-case/sigil/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.6",
    "d3-geo": "^3.1.1",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.2",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-themes": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@types/cors": "^2.8.19",
    "@types/d3-geo": "^3.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.3",
    "storybook": "^10.4.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.5",
    "world-countries": "^5.1.0"
  }
}
