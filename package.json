{
  "name": "@real-case/sigil",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Live, interactive chart widgets for Claude and other MCP Apps hosts. Sigils carry meaning compressed into a glyph — same idea, applied to data.",
  "homepage": "https://sigil.live",
  "type": "module",
  "bin": {
    "sigil": "./dist/server/stdio.js"
  },
  "main": "./dist/server/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "dev:preview": "WIDGET=palette-preview vite",
    "build": "npm run build:widgets && npm run build:server",
    "build:widgets": "tsx scripts/build-widgets.ts",
    "build:server": "tsc -p tsconfig.server.json && chmod +x dist/server/stdio.js",
    "start": "node dist/server/server.js",
    "start:stdio": "node dist/server/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "rm -rf dist && npm run build"
  },
  "keywords": [
    "sigil",
    "mcp",
    "model-context-protocol",
    "mcp-apps",
    "claude",
    "charts",
    "visualization",
    "interactive",
    "dashboard"
  ],
  "license": "MIT",
  "author": "Yurii Anichkin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/real-case/sigil.git"
  },
  "bugs": {
    "url": "https://github.com/real-case/sigil/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.6",
    "express": "^4.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^4.1.5"
  }
}
